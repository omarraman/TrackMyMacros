@using TrackMyMacros.SharedKernel
<div class="container mb-3">
    <RadzenCard>
        
    <div class="row py-1 px-3" T>
        <div class="col-4">
            <RadzenLabel>Day</RadzenLabel>
        </div>
        <div class="col-8">

            <RadzenDropDown Style="width: auto" @bind-Value=@Workout.DayOfWeek Data=@Days
                            TextProperty="StringEquiv"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.StartsWith" AllowFiltering="true"

                            Placeholder="Select Day"/>
        </div>
    </div>
    <div class="row py-1 px-3" T>
        <div class="col-4">
            <RadzenLabel>Exercise</RadzenLabel>
        </div>
        <div class="col-4">
            <RadzenLabel>Target Reps</RadzenLabel>
        </div>
        <div class="col-4">
            <RadzenLabel>Target Weight</RadzenLabel>
        </div>
    </div>

    @for (int i = 0; i < Workout.SetGroupsInPriorityOrder.Count; i++)
    {
        var hasPrior = i != 0;
        var hasFollowing = i < Workout.SetGroupsInPriorityOrder.Count - 1;
        <AddSetGroupComponent SetGroup="Workout.SetGroupsInPriorityOrder[i]" Exercises="@Exercises" HasPrior="hasPrior" HasFollowing="hasFollowing" 
        SetGroupMovedDown="OnSetGroupMovedDown" SetGroupMovedUp="OnSetGroupMovedUp"/>
    }
    
    
    @*
    @foreach (var setGroup in Workout.SetGroups)
    {
        
        <AddSetGroupComponent SetGroup="setGroup" Exercises="@Exercises"  />
    }*@


    <RadzenButton Icon="add" Click="OnAddSet" Style="margin-top: 10px;"/>
    </RadzenCard>
    
</div>