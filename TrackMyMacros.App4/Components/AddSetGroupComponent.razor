@using TrackMyMacros.App4.ViewModels.SetGroup
<div class="container">

    <div class="row py-1 px-3" T>
        <div class="col-4">
            <RadzenDropDown Style="width: auto" @bind-Value=@SetGroup.ExerciseId Data=@Exercises
                            TextProperty="Name" ValueProperty="Id"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.StartsWith" AllowFiltering="true"
                            Placeholder="Select Exercise"/>
        </div>
        <div class="col-3">
            <RadzenNumeric TValue="int" @bind-Value="@SetGroup.Sets[0].TargetReps">Reps</RadzenNumeric>
        </div>
        <div class="col-3">
            <RadzenNumeric TValue="double" @bind-Value="@SetGroup.Sets[0].TargetWeight">Reps</RadzenNumeric>
        </div>

        <div class="col-1">
            @if (HasPrior)
            {
                <RadzenButton Icon="arrow_upward" Click="OnMoveUp" Style="margin-top: 10px;"/>
            }

        </div>
        <div class="col-1">
            @if (HasFollowing)
            {
                <RadzenButton Icon="arrow_downward" Click="OnMoveDown" Style="margin-top: 10px;"/>
            }
        </div>
        


        
    </div>
</div>